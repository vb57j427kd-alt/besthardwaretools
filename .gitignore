__pycache__/
*.pyc

# Raw pre-processing image downloads must never be published:
# they still carry Chinese text and third-party brand marks.
images/*_raw.jpg
images/*_raw.png

# One-off scratch scripts and their working output.
# Batch dumps (chunk*.txt) and copy JSON belong here, not in the repo: a stray
# `git add -A` must not publish half-finished copy plans.
_tmp_*.py
_tmp_*.json
_tmp_*.txt
_tmp_*.log
_tmp_*/

# Scratch slug inventories and staged image downloads from daily ops runs
_all_slugs.json
_cat_slugs.txt
_slugs_now.txt
_tmp_imgs/

# local backups from the daily-ops scripts
*.bak
